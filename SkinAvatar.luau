 local _x=(_v[string.byte(_p,_i)] or 0)*262144+(_v[string.byte(_p,_i+1)] or 0)*4096+(_v[string.byte(_p,_i+2)] or 0)*64+(_v[string.byte(_p,_i+3)] or 0)
